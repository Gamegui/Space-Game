k) {\n  callback = typeof options === 'function' ? options : callback;\n  validateFunction(callback\x2C 'callback');\n\n  path = getValidatedPath(path);\n  options = getOptions(options\x2C {\n    encoding: 'utf8'\x2C\n  });\n\n  function opendirCallback(error\x2C handle) {\n    if (error) {\n      callback(error);\n    } else {\n      callback(null\x2C new Dir(handle\x2C path\x2C options));\n    }\n  }\n\n  const req = new FSReqCallback();\n  req.oncomplete = opendirCallback;\n\n  dirBinding.opendir(\n    path\x2C\n    options.encoding\x2C\n    req\x2C\n  );\n}\n\nfunction opendirSync(path\x2C options) {\n  path = getValidatedPath(path);\n  options = getOptions(options\x2C { encoding: 'utf8' });\n\n  const handle = dirBinding.opendirSync(path);\n\n  return new Dir(handle\x2C path\x2C options);\n}\n\nmodule.exports = {\n  Dir\x2C\n  opendir\x2C\n  opendirSync\x2C\n};\n
